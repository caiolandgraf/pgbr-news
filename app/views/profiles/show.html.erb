<% content_for :title, "@#{@user.username}" %>
<% if @user.bio.present? %>
  <% content_for :head do %>
    <%= render "articles/markdown_styles" %>
  <% end %>
<% end %>

<div class="space-y-8">
  <header class="border-b border-zinc-200 pb-6 dark:border-zinc-800">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
          @<%= @user.username %>
        </h1>
        <% if @user.name.present? %>
          <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400"><%= @user.name %></p>
        <% end %>
        <p class="mt-2 text-xs text-zinc-500 dark:text-zinc-500">
          <%= pluralize(@articles.size, "publicação", "publicações") %> ·
          membro desde <%= @user.created_at.strftime("%d/%m/%Y") %>
        </p>
      </div>

      <% if logged_in? && current_user == @user %>
        <%= link_to "Editar perfil", edit_profile_path(@user),
            class: "rounded-lg border border-zinc-300 bg-white px-4 py-2 text-sm font-medium text-zinc-700 shadow-sm hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:bg-zinc-800 transition-colors" %>
      <% end %>
    </div>

    <% if @user.bio.present? %>
      <div class="tabnews-markdown-viewer mt-6" data-controller="markdown-viewer">
        <textarea hidden data-markdown-viewer-target="source"><%= @user.bio %></textarea>
        <div data-markdown-viewer-target="mount"></div>
      </div>
    <% else %>
      <p class="mt-6 text-sm text-zinc-500 dark:text-zinc-400 italic">
        <% if logged_in? && current_user == @user %>
          Você ainda não escreveu uma bio.
          <%= link_to "Adicionar agora", edit_profile_path(@user), class: "text-emerald-600 hover:underline dark:text-emerald-400" %>.
        <% else %>
          Este usuário ainda não adicionou uma bio.
        <% end %>
      </p>
    <% end %>
  </header>

  <section>
    <h2 class="mb-4 text-lg font-semibold text-zinc-900 dark:text-zinc-100">Publicações</h2>

    <% if @articles.any? %>
      <ol class="list-none space-y-5 p-0 m-0">
        <% @articles.each_with_index do |article, index| %>
          <li>
            <%= render "articles/article", article: article, position: index + 1 %>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        <% if logged_in? && current_user == @user %>
          Você ainda não publicou nada.
          <%= link_to "Criar primeira publicação", new_article_path, class: "text-emerald-600 hover:underline dark:text-emerald-400" %>.
        <% else %>
          Nenhuma publicação ainda.
        <% end %>
      </p>
    <% end %>
  </section>
</div>
