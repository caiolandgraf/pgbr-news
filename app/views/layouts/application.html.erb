<!DOCTYPE html>
<html lang="pt-BR" class="h-full" data-color-mode="light" data-light-theme="light" data-dark-theme="dark">
  <head>
    <title data-inertia><%= content_for(:title) || "Blog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Blog">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "primer-light", "primer-dark", "bytemd", "bytemd_theme", "tabnews-editor", "tabnews-viewer", "hljs-github", "data-turbo-track": "reload" %>
    <link id="hljs-markdown-dark" rel="stylesheet" href="<%= asset_path("hljs-github-dark.css") %>" data-turbo-track="reload" disabled>

    <script>
      (function () {
        const isDark =
          localStorage.theme === "dark" ||
          (!("theme" in localStorage) &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);
    
        const root = document.documentElement;
    
        root.classList.toggle("dark", isDark);
        root.dataset.colorMode = isDark ? "dark" : "light";
      })();
    </script>
    <%= vite_client_tag %>
    <%= vite_javascript_tag "inertia" %>
    <%= inertia_ssr_head %>
  </head>

  <body class="min-h-full bg-[var(--bgColor-default)] text-[var(--fgColor-default)] antialiased">
    <%= yield %>
  </body>
</html>
