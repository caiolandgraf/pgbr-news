<header class="sticky top-0 z-50 border-b border-zinc-800 bg-zinc-900 text-zinc-100 shadow-sm" data-controller="theme">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-3 px-4 py-3 sm:gap-4 sm:px-6">
    <%= link_to root_path, class: "flex shrink-0 items-center gap-2 font-semibold tracking-tight text-white hover:text-emerald-400 transition-colors" do %>
      <svg class="h-5 w-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z" />
      </svg>
      <span>Blog</span>
    <% end %>

    <nav class="flex items-center gap-4 text-sm">
      <%= link_to "Recentes", root_path(sort: "recent"),
          class: "text-zinc-300 hover:text-white transition-colors #{'text-white font-medium' if params[:sort] != 'relevant'}" %>
      <%= link_to "Relevantes", root_path(sort: "relevant"),
          class: "text-zinc-300 hover:text-white transition-colors #{'text-white font-medium' if params[:sort] == 'relevant'}" %>
    </nav>

    <div class="order-last w-full sm:order-none sm:mx-4 sm:flex-1 sm:max-w-md">
      <label class="relative block">
        <span class="sr-only">Pesquisar</span>
        <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
        </svg>
        <input type="search" placeholder="Pesquisar" disabled
          class="w-full rounded-lg border border-zinc-700 bg-zinc-800 py-2 pl-10 pr-3 text-sm text-zinc-100 placeholder:text-zinc-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500 disabled:cursor-not-allowed disabled:opacity-60" />
      </label>
    </div>

    <div class="ml-auto flex items-center gap-2 sm:gap-3">
      <button type="button" data-action="theme#toggle"
        class="rounded-lg p-2 text-zinc-400 hover:bg-zinc-800 hover:text-white transition-colors"
        aria-label="Alternar tema">
        <svg data-theme-target="iconMoon" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
        </svg>
        <svg data-theme-target="iconSun" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
        </svg>
      </button>

      <% if logged_in? %>
        <%= link_to profile_path(current_user),
            class: "max-w-[9rem] truncate rounded-lg px-3 py-1.5 text-sm text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors" do %>
          @<%= current_user.username %>
        <% end %>
        <%= button_to "Sair", logout_path, method: :delete,
            class: "rounded-lg px-3 py-1.5 text-sm text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors" %>
        <%= link_to "Publicar", new_article_path,
            class: "rounded-lg bg-emerald-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-emerald-500 transition-colors" %>
      <% else %>
        <%= link_to "Login", login_path,
            class: "rounded-lg px-3 py-1.5 text-sm text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors" %>
        <%= link_to "Cadastrar", new_user_path,
            class: "rounded-lg bg-emerald-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-emerald-500 transition-colors" %>
      <% end %>
    </div>
  </div>
</header>
