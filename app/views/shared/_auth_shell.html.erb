<% content_for :hide_flash, true %>
<% content_for :main_class, "max-w-lg w-full" %>

<div class="flex min-h-[calc(100dvh-8rem)] flex-col justify-center py-8">
  <div class="mb-6 text-center">
    <%= link_to root_path, class: "inline-flex items-center gap-2 text-zinc-900 hover:text-emerald-600 dark:text-zinc-100 dark:hover:text-emerald-400 transition-colors" do %>
      <svg class="h-6 w-6 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z" />
      </svg>
      <span class="text-lg font-semibold tracking-tight">Blog</span>
    <% end %>
  </div>

  <%= render "shared/auth_tabs" %>

  <div class="rounded-xl border border-zinc-200 bg-white p-6 shadow-sm sm:p-8 dark:border-zinc-800 dark:bg-zinc-900/50 dark:shadow-none">
    <%= yield %>
  </div>

  <p class="mt-6 text-center text-xs text-zinc-500 dark:text-zinc-500">
    <%= link_to "← Voltar para o feed", root_path, class: "hover:text-zinc-700 dark:hover:text-zinc-300 transition-colors" %>
  </p>
</div>
