<% if record.errors.any? %>
  <div class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-900/50 dark:bg-red-950/40 dark:text-red-200" role="alert">
    <p class="font-medium">Revise os campos abaixo:</p>
    <ul class="mt-2 space-y-1">
      <% record.errors.full_messages.each do |message| %>
        <li class="flex gap-2">
          <span aria-hidden="true">·</span>
          <%= message %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
