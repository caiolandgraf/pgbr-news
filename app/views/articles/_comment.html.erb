<div class="flex gap-4 article-comment rounded-md p-4">
  <div class="flex flex-col items-center">
    <%= button_to user_article_vote_comment_path(
      comment.article.user.username,
      comment.article.slug,
      comment,
      up: true
    ),
    method: :patch,
    class: "comment-vote-button text-sm text-gray-500 rounded-lg p-2 hover:dark:bg-white/5 hover:bg-black/5 transition cursor-pointer flex items-center gap-2 justify-center" do %>
      <%= lucide_icon "chevron-up", class: "w-4 h-4" %>
    <% end %>

    <span class="comment-score text-sm font-semibold mt-1">
      <%= comment.popularity %>
    </span>

    <%= button_to user_article_vote_comment_path(
      comment.article.user.username,
      comment.article.slug,
      comment,
      down: true
    ),
    method: :patch,
    class: "comment-vote-button text-sm text-gray-500 rounded-lg p-2 hover:dark:bg-white/5 hover:bg-black/5 transition cursor-pointer flex items-center gap-2 justify-center mt-1" do %>
      <%= lucide_icon "chevron-down", class: "w-4 h-4" %>
    <% end %>

    <% if comment.children.any? %>
      <div class="w-px flex-1 bg-zinc-800 mt-2"></div>
    <% end %>
  </div>

  <div class="flex-1">
    <div class="comment-meta text-sm text-zinc-400">
      <span class="comment-author font-medium">@<%= comment.user.username %></span>
      <span class="mx-2">·</span>
      <span><%= time_ago_pt(comment.created_at) %></span>
    </div>

    <div class="comment-body mt-2">
      <%= simple_format(h(comment.body)) %>
    </div>

    <% if logged_in? %>
      <button
        onclick="document.getElementById('reply-<%= comment.id %>').classList.toggle('hidden')"
        class="comment-reply-button mt-3 inline-flex items-center gap-2 rounded-md border px-3 py-1 text-sm transition">
        Responder
      </button>

      <div id="reply-<%= comment.id %>" class="hidden mt-3">
        <%= form_with model: ArticleComment.new,
          url: user_article_create_comment_comment_path(
            @article.user.username,
            @article.slug,
            comment
          ),
          class: "flex flex-col gap-2" do |f| %>

          <%= render partial: "shared/markdown_field", locals: { form: f, field: :body, max_length: ArticleComment::BODY_MAX_LENGTH, required: true, compact: true } %>

          <%= f.submit "Enviar",
            class: "w-fit rounded-lg border border-emerald-500 px-3 py-1 text-sm text-emerald-500" %>
        <% end %>
      </div>
    <% end %>

    <% if comment.children.any? %>
      <div class="mt-6 space-y-6 border-l border-zinc-800 pl-6">
        <%= render partial: "articles/comment",
          collection: comment.children.order(popularity: :desc),
          as: :comment %>
      </div>
    <% end %>
  </div>
</div>