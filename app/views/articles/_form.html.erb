<% body_max = Article::BODY_MAX_LENGTH %>
<% publish_mode = !article.persisted? %>
<% page_title = publish_mode ? "Publicar novo conteúdo" : "Editar publicação" %>
<% submit_label = publish_mode ? "Publicar" : "Salvar" %>
<% cancel_path = article.persisted? ? user_article_path(article.user.username, article.slug) : root_path %>

<% content_for :head do %>
  <%= render "articles/editor_assets" %>
<% end %>

<%= form_with model: article,
    class: "space-y-6",
    data: {
      controller: "article-editor",
      article_editor_max_value: body_max
    } do |form| %>

  <% if article.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900/60 dark:bg-red-950/50 dark:text-red-200">
      <p class="font-medium"><%= pluralize(article.errors.count, "erro") %> impediram o salvamento:</p>
      <ul class="mt-1 list-inside list-disc">
        <% article.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <header>
    <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 sm:text-3xl">
      <%= page_title %>
    </h1>
  </header>

  <div class="space-y-2">
    <%= form.label :title, class: "block text-sm text-zinc-600 dark:text-zinc-400" do %>
      Título <span class="text-zinc-400 dark:text-zinc-500" aria-hidden="true">*</span>
    <% end %>
    <%= form.text_field :title,
        required: true,
        autofocus: publish_mode,
        placeholder: "Título da publicação",
        class: "w-full rounded-md border border-zinc-300 bg-white px-3 py-2.5 text-sm text-zinc-900 shadow-sm placeholder:text-zinc-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/40 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:placeholder:text-zinc-600" %>
  </div>

  <div class="space-y-2">
    <%= form.label :body, class: "block text-sm text-zinc-600 dark:text-zinc-400" do %>
      Corpo da publicação <span class="text-zinc-400 dark:text-zinc-500" aria-hidden="true">*</span>
    <% end %>

    <div class="bytemd-editor-container overflow-hidden rounded-md border border-zinc-300 shadow-sm focus-within:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500/40 dark:border-[var(--borderColor-default)] dark:bg-[var(--bgColor-default)] dark:focus-within:border-[var(--fgColor-accent)] dark:focus-within:ring-[var(--fgColor-accent)]/30">
      <div data-article-editor-target="mount" class="block w-full min-h-[360px]"></div>
      <%= form.text_area :body,
          required: true,
          class: "hidden",
          data: { article_editor_target: "body" } %>
      <div class="flex justify-end border-t border-zinc-200 bg-zinc-50 px-3 py-1.5 dark:border-[var(--borderColor-default)] dark:bg-[var(--bgColor-muted)]">
        <span data-article-editor-target="counter" class="text-xs tabular-nums text-zinc-500"><%= article.body.to_s.length %>/<%= body_max %></span>
      </div>
    </div>

    <p class="text-xs text-zinc-500 dark:text-zinc-500">
      Editor Markdown igual ao TabNews. Use <strong>Visualizar</strong> ou o ícone de lado a lado na barra para alternar o layout.
    </p>
  </div>

  <div class="space-y-2">
    <%= form.label :ref, "Fonte", class: "block text-sm text-zinc-600 dark:text-zinc-400" %>
    <%= form.url_field :ref,
        placeholder: "https://origem.site/noticia",
        class: "w-full rounded-md border border-zinc-300 bg-white px-3 py-2.5 text-sm text-zinc-900 shadow-sm placeholder:text-zinc-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/40 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:placeholder:text-zinc-600" %>
  </div>

  <p class="text-sm text-zinc-500 dark:text-zinc-500">
    Os campos marcados com um asterisco (<span aria-hidden="true">*</span>) são obrigatórios.
  </p>

  <div class="flex flex-wrap items-center justify-end gap-3 pt-2">
    <%= link_to "Cancelar", cancel_path,
        class: "rounded-md px-4 py-2 text-sm font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors" %>
    <%= form.submit submit_label,
        class: "cursor-pointer rounded-md bg-emerald-600 px-5 py-2 text-sm font-medium text-white shadow-sm hover:bg-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 dark:focus:ring-offset-zinc-950 transition-colors" %>
  </div>
<% end %>
