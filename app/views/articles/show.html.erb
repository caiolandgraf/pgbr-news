<% content_for :head do %>
  <%= render "articles/markdown_styles" %>
<% end %>

<% content_for :title, @article.title %>

<% if @article.errors.any? %>
  <div class="rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900/60 dark:bg-red-950/50 dark:text-red-200">
    <p class="font-medium">
      <%= pluralize(@article.errors.count, "erro") %> impediram o salvamento:
    </p>

    <ul class="mt-1 list-inside list-disc">
      <% @article.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="flex gap-4">
  <div class="flex items-center flex-col gap-4">
    <%= button_to user_article_vote_path(@article.user.username, @article.slug, up: true), method: :patch, data: { turbo: false },
      class: "text-sm text-gray-500 rounded-lg p-2 hover:dark:bg-white/5 hover:bg-black/5 transition cursor-pointer flex items-center gap-2 justify-center" do %>
     <%= lucide_icon "chevron-up", class: "w-4 h-4 " %>
    <% end %>

    <span class="text-sm text-emerald-500 font-semibold">
      <%= @article.popularity %>
    </span>

    <%= button_to user_article_vote_path(@article.user.username, @article.slug, down: true), method: :patch, data: { turbo: false },
      class: "text-sm text-gray-500 rounded-lg p-2 hover:dark:bg-white/5 hover:bg-black/5 transition cursor-pointer flex items-center gap-2 justify-center" do %>
      <%= lucide_icon "chevron-down", class: "w-4 h-4" %>
    <% end %>

    <div class="w-[2px] h-full dark:bg-white/10 bg-black/10 rounded-full"></div>
  </div>

<article>
  <h1 class="text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
    <%= @article.title %>
  </h1>

  <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">
    <%= @article.popularity || 0 %> pontos ·
    <%= link_to "@#{@article.user.username}", profile_path(@article.user),
        class: "hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors" %> ·
    <%= time_ago_pt(@article.created_at) %>
  </p>

  <% if @article.ref.present? %>
    <p class="mt-2 text-sm">
      <%= link_to "Fonte", @article.ref, target: "_blank", rel: "noopener noreferrer",
          class: "text-emerald-600 hover:underline dark:text-emerald-400" %>
    </p>
  <% end %>

  <div class="tabnews-markdown-viewer"
       data-controller="markdown-viewer">
    <textarea hidden data-markdown-viewer-target="source"><%= @article.body %></textarea>
    <div data-markdown-viewer-target="mount"></div>
  </div>
</article>
</div>

<div class="mt-10 flex flex-wrap gap-3 border-t border-zinc-200 pt-6 dark:border-zinc-800">
  <%= link_to root_path,
    class: "text-sm rounded-lg border-emerald-500 text-emerald-500 px-3 py-1 hover:text-emerald-400 transition cursor-pointer flex items-center gap-2 justify-center" do %>
    <%= lucide_icon "arrow-left", class: "w-4 h-4" %>
    Voltar
  <% end %>

  <% if logged_in? && current_user == @article.user %>
    <%= link_to user_edit_article_path(@article.user.username, @article.slug),
        class: "text-sm border border-blue-500 rounded-lg bg-blue-500 text-white px-3 py-1 hover:bg-blue-400 hover:border-blue-400 transition cursor-pointer flex items-center gap-2 justify-center" do %>
      <%= lucide_icon "pencil", class: "w-4 h-4" %>
      Editar
    <% end %>
    
    <%= button_to @article, method: :delete,
        class: "text-sm border border-red-500 rounded-lg bg-red-500 text-white px-3 py-1 hover:bg-red-400 hover:border-red-400 transition cursor-pointer flex items-center gap-2 justify-center",
        data: { turbo_confirm: "Tem certeza?" } do %>
      <%= lucide_icon "trash-2", class: "w-4 h-4" %>
      Excluir
    <% end %>
  <% end %>
</div>
