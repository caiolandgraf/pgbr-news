<article id="<%= dom_id article %>" class="group">
  <div class="flex gap-3">
    <span class="mt-0.5 w-6 shrink-0 text-right text-sm font-medium text-zinc-400 dark:text-zinc-600 tabular-nums">
      <%= local_assigns[:position] %>
    </span>
    <div class="min-w-0 flex-1">
      <%= link_to user_article_path(article.user.username, article.slug), class: "block" do %>
        <h2 class="text-base font-semibold text-zinc-900 group-hover:text-emerald-600 dark:text-zinc-100 dark:group-hover:text-emerald-400 transition-colors leading-snug">
          <%= article.title %>
        </h2>
      <% end %>
      <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-500">
        <span><%= article.popularity || 0 %> pontos</span>
        <span class="mx-1">·</span>
        <%= link_to "@#{article.user.username}", profile_path(article.user),
            class: "hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors" %>
        <span class="mx-1">·</span>
        <time datetime="<%= article.created_at.iso8601 %>"><%= time_ago_pt(article.created_at) %></time>
      </p>
    </div>
  </div>
</article>
