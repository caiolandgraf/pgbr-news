<% content_for :title, "Recentes" %>

<% if @featured_article %>
  <article class="mb-8 border-b border-zinc-200 pb-6 dark:border-zinc-800">
    <%= link_to user_article_path(@featured_article.user.username, @featured_article.slug), class: "group block" do %>
      <h2 class="text-lg font-semibold text-emerald-600 group-hover:text-emerald-500 dark:text-emerald-400 dark:group-hover:text-emerald-300 transition-colors">
        <%= @featured_article.title %>
      </h2>
      <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400 line-clamp-2">
        <%= truncate(@featured_article.body, length: 160) %>
      </p>
    <% end %>
    <p class="mt-2 text-xs text-zinc-500 dark:text-zinc-500">
      <%= @featured_article.popularity || 0 %> pontos ·
      <%= link_to "@#{@featured_article.user.username}", profile_path(@featured_article.user),
          class: "hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors" %> ·
      <%= time_ago_pt(@featured_article.created_at) %>
    </p>
  </article>
<% end %>

<ol class="list-none space-y-5 p-0 m-0" id="articles">
  <% @articles.each_with_index do |article, index| %>
  <li>
    <%= render "articles/article", article: article, position: index + 1 %>
  </li>
  <% end %>
</ol>

<% if @articles.empty? %>
  <p class="py-12 text-center text-zinc-500 dark:text-zinc-400">
    Nenhum artigo ainda.
    <% if logged_in? %>
      <%= link_to "Seja o primeiro a publicar", new_article_path, class: "text-emerald-600 hover:underline dark:text-emerald-400" %>.
    <% else %>
      <%= link_to "Cadastre-se", new_user_path, class: "text-emerald-600 hover:underline dark:text-emerald-400" %> para publicar.
    <% end %>
  </p>
<% end %>
