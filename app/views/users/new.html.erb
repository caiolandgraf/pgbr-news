<% content_for :title, "Criar conta" %>

<%= render layout: "shared/auth_shell" do %>
  <header class="mb-6">
    <h1 class="text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">Crie sua conta</h1>
    <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">Leva menos de um minuto para começar a publicar.</p>
  </header>

  <%= render "shared/auth_errors", record: @user %>

  <%= form_with model: @user,
      class: "space-y-5",
      data: {
        controller: "signup-form",
        signup_form_min_value: User::PASSWORD_MIN_LENGTH,
        action: "input->signup-form#validate"
      } do |form| %>

    <div class="space-y-1.5">
      <%= form.label :username, "Usuário", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
      <div class="<%= auth_field_wrapper_class %>">
        <span class="flex items-center border-r border-zinc-200 bg-zinc-50 px-3 text-sm font-medium text-zinc-500 dark:border-zinc-700 dark:bg-zinc-800/50 dark:text-zinc-400">@</span>
        <%= form.text_field :username,
            required: true,
            autofocus: true,
            autocomplete: "username",
            placeholder: "seu_usuario",
            spellcheck: false,
            class: auth_input_class %>
      </div>
      <p class="text-xs text-zinc-500 dark:text-zinc-500">Letras, números e underscore. Aparece nas suas publicações.</p>
    </div>

    <div class="space-y-1.5">
      <%= form.label :email, "E-mail", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
      <div class="<%= auth_field_wrapper_class %>">
        <span class="flex items-center pl-3 text-zinc-400 dark:text-zinc-500" aria-hidden="true">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
          </svg>
        </span>
        <%= form.email_field :email,
            required: true,
            autocomplete: "email",
            placeholder: "voce@email.com",
            class: auth_input_class %>
      </div>
    </div>

    <div class="space-y-1.5" data-controller="password-visibility">
      <%= form.label :password, "Senha", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
      <div class="<%= auth_field_wrapper_class %>">
        <%= form.password_field :password,
            required: true,
            minlength: User::PASSWORD_MIN_LENGTH,
            autocomplete: "new-password",
            placeholder: "Mínimo #{User::PASSWORD_MIN_LENGTH} caracteres",
            data: { password_visibility_target: "input", signup_form_target: "password" },
            class: auth_input_class %>
        <button type="button" data-action="password-visibility#toggle"
          class="shrink-0 px-3 text-xs font-medium text-zinc-500 hover:text-zinc-800 dark:text-zinc-400 dark:hover:text-zinc-200 transition-colors">
          <span data-password-visibility-target="showLabel">Mostrar</span>
          <span data-password-visibility-target="hideLabel" class="hidden">Ocultar</span>
        </button>
      </div>
      <p data-signup-form-target="lengthHint" class="text-xs text-zinc-500">Pelo menos <%= User::PASSWORD_MIN_LENGTH %> caracteres</p>
    </div>

    <div class="space-y-1.5" data-controller="password-visibility">
      <%= form.label :password_confirmation, "Confirmar senha", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
      <div class="<%= auth_field_wrapper_class %>">
        <%= form.password_field :password_confirmation,
            required: true,
            autocomplete: "new-password",
            placeholder: "Repita a senha",
            data: { password_visibility_target: "input", signup_form_target: "confirmation" },
            class: auth_input_class %>
        <button type="button" data-action="password-visibility#toggle"
          class="shrink-0 px-3 text-xs font-medium text-zinc-500 hover:text-zinc-800 dark:text-zinc-400 dark:hover:text-zinc-200 transition-colors">
          <span data-password-visibility-target="showLabel">Mostrar</span>
          <span data-password-visibility-target="hideLabel" class="hidden">Ocultar</span>
        </button>
      </div>
      <p data-signup-form-target="matchHint" class="hidden text-xs"></p>
    </div>

    <%= form.submit "Criar conta",
        class: "w-full cursor-pointer rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 dark:focus:ring-offset-zinc-900 transition-colors" %>
  <% end %>

  <p class="mt-6 border-t border-zinc-100 pt-6 text-center text-sm text-zinc-500 dark:border-zinc-800 dark:text-zinc-400">
    Já tem conta?
    <%= link_to "Entrar", login_path, class: "font-medium text-emerald-600 hover:text-emerald-500 dark:text-emerald-400 transition-colors" %>
  </p>
<% end %>
